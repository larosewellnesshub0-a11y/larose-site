<input id="wa-ref" placeholder="[LR-source-campaign]" dir="ltr">
<input type="checkbox" data-check="${i}" ${saved[i]?'checked':''}>
<input data-tip="id" data-i="${i}" value="${esc(t.id)}" pattern="[a-z0-9]+(?:-[a-z0-9]+)*">
<textarea data-tip="ar" data-i="${i}">
<textarea data-tip="en" data-i="${i}" dir="ltr">
<input id="leads-token" type="password" value="${esc(token)}" autocomplete="off">


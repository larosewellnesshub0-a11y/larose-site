+.admin-nav__group{margin:1rem .85rem .35rem;color:var(--muted);font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.admin-nav__group small{display:block;font-size:.64rem}.growth-toolbar,.lead-filters{display:flex;flex-wrap:wrap;gap:.75rem;align-items:end;margin-block:1rem}.growth-toolbar label,.lead-filters label{display:grid;gap:.3rem;min-width:9rem}.growth-toolbar select,.lead-filters input,.lead-filters select,.tool-grid input,.tool-grid select,.tool-grid textarea,.tips-editor input,.tips-editor textarea,.lead-table input,.lead-table select{min-height:2.75rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper);padding:.55rem;color:inherit}.lead-table table{min-width:1050px}.lead-table td{vertical-align:top}.lead-table td small{display:block}.growth-empty{padding:1rem;border:1px dashed var(--line);border-radius:.7rem;display:grid;gap:.25rem}.growth-chart{width:100%;height:auto;min-height:120px}.growth-chart rect{fill:var(--olive)}.growth-chart text{font-size:12px;fill:currentColor}.funnel{display:grid;gap:.55rem}.funnel div{width:max(8rem,var(--w));max-width:100%;padding:.7rem;background:var(--olive);color:white;border-radius:.45rem}.heatmap{display:grid;grid-template-columns:repeat(24,1fr);gap:2px;direction:ltr}.heatmap span{aspect-ratio:1;background:color-mix(in srgb,var(--olive) calc(var(--heat)*90%),#eee);border-radius:2px}.tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.tool-grid label{display:grid;gap:.35rem}.tool-grid output{grid-column:1/-1;direction:ltr;overflow-wrap:anywhere;padding:.8rem;background:var(--paper-deep);border-radius:.5rem}.qr-svg{width:min(220px,100%);height:auto}.landing-list details,.copy-bank article,.tips-editor article{border:1px solid var(--line);border-radius:.7rem;padding:1rem;margin:.65rem 0;background:var(--paper)}.copy-bank{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:.75rem}.copy-line{display:block;width:100%;min-height:44px;text-align:start;margin:.35rem 0;border:1px solid var(--line);background:transparent;border-radius:.4rem}.checklist{display:grid;gap:.7rem}.checklist label{min-height:44px;display:flex;gap:.7rem;align-items:center}.tips-editor textarea{width:100%;min-height:7rem}.tips-editor article{display:grid;gap:.6rem}.tips-editor label{display:grid;gap:.25rem}.item-actions{display:flex;gap:.35rem}.item-actions button{min-width:44px;min-height:44px}.lead-analytics{margin-block:1rem 2rem}
+@media(max-width:45rem){.tool-grid{grid-template-columns:1fr}.lead-table table,.lead-table thead{display:block;min-width:0}.lead-table thead{position:absolute;clip:rect(0 0 0 0)}.lead-table tbody,.lead-table tr,.lead-table td{display:block;width:100%}.lead-table tr{border:1px solid var(--line);border-radius:.7rem;padding:.8rem;margin:.7rem 0}.lead-table td{border:0;padding:.35rem}.heatmap{grid-template-columns:repeat(12,1fr)}.growth-toolbar>*{flex:1 1 9rem}.admin-main{overflow-x:hidden}}
+
 .admin-body {
   min-width: 20rem;
   min-height: 100vh;

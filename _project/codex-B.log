        <p class="field-help">داخل <code>site/assets/img/</code>، استخدم اسماً قصيراً بالإنجليزية.</p>
      </div>

      <div class="admin-field">
        <label for="upload-file">اختيار الصورة <small lang="en" dir="ltr">Choose image</small></label>
        <input id="upload-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/svg+xml" required>
        <p class="field-help">JPG, PNG, WebP, AVIF أو SVG، الحد الأقصى 12 MB.</p>
      </div>

      <div class="dialog-actions">
        <button class="admin-btn admin-btn--primary" type="submit">

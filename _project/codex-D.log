+}
+const failures = results.filter((item) => item.status !== 200);
+console.log(`\n${results.length} URLs checked; ${failures.length} non-200 response${failures.length === 1 ? "" : "s"}.`);
+process.exitCode = failures.length ? 1 : 0;

function clickAction(dataset) {
  const target = {
    dataset,
    closest(selector) {
      return selector === "[data-action]" ? this : null;
    },
  };
  for (const listener of documentListeners.click || []) listener({ target });
}

/* Counts come from the live content, not from constants. They used to be

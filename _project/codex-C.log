    method: "PUT",
    headers: {
      "content-type": "application/json",
      "x-content-rev": liveContent.__revs?.["site.json"] || "",
    },
    body: JSON.stringify(invalidPrice),
  },
);
const invalidPriceBody = await invalidPriceResponse.json();
check(
  invalidPriceResponse.status === 422,

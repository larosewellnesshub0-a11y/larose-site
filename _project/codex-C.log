                                             f"Knowledge Centre > {en} category"),
                        live_url(domain, f"articles/category-{slug}.html") if slug else "")

    record, index = indexed_record(root, "articles", tokens)
    ar, en = name_pair(record, f"محتوى {index + 1}", f"Entry {index + 1}")

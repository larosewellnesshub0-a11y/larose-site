+    dirty: porcelain.out.split(/\r?\n/).filter(Boolean).map((line) => line.slice(3)),
+    lastCommit: hash ? { hash, date, message: message.join("\t") } : null,
+    remote: remoteResult.ok ? remoteResult.out.trim() : null,
+  };
+}

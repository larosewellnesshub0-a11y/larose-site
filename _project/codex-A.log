.rg-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-block-start: 1.1rem; }
.rg-tag {
  padding-block: .25rem;
  padding-inline: .6rem;
  background: var(--paper-sunk);
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink-muted);
  font-size: var(--t-xs);
}

/* ---- call to action ------------------------------------------------------ */

.rg-cta {
  margin-block: clamp(2.5rem, 2rem + 2vw, 4.5rem);
  padding-block: clamp(2.25rem, 1.8rem + 2vw, 3.5rem);
  background: var(--olive-800);
  color: var(--ink-on-dark);
  text-align: center;
}

.rg-cta__title { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: var(--lh-head); }
.rg-cta__text {
  max-inline-size: 50ch;
  margin-block-start: .8rem;
  margin-inline: auto;
  color: rgba(246, 244, 236, .8);
}

.rg-cta__actions { display: flex; flex-wrap: wrap; gap: .7rem; justify-content: center; margin-block-start: 1.4rem; }

.rg-btn {
  padding-block: .7rem;
  padding-inline: 1.4rem;
  border: 1px solid rgba(246, 244, 236, .45);
  border-radius: 999px;
  color: var(--ink-on-dark);
  font-weight: 600;
  text-decoration: none;
}
.rg-btn:hover { background: rgba(246, 244, 236, .1); }
.rg-btn--primary { background: var(--rose-700); border-color: transparent; }
.rg-btn--primary:hover { background: var(--rose-600, var(--rose-700)); }

/* ---- footer -------------------------------------------------------------- */

.rg-foot {
  padding-block: clamp(2rem, 1.5rem + 2vw, 3rem);
  border-block-start: 1px solid var(--line);
  color: var(--ink-muted);
  font-size: var(--t-sm);
  text-align: center;
}
.rg-foot a { color: var(--ink-strong); }
.rg-foot__meta { margin-block-start: .5rem; }

@media print {
  .rg-head, .rg-cta, .rg-toc { display: none; }
  .rg-card { break-inside: avoid; box-shadow: none; }
}

/* The video link closes each card: the reader has the recipe, and this is the
   point at which watching it made is the natural next step. */
.rg-watch { margin-block-start: 1.2rem; }

.rg-watch__btn {
  display: inline-flex;
  gap: .5rem;
  align-items: center;
  padding-block: .55rem;
  padding-inline: 1rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink-strong);
  font-size: var(--t-sm);
  font-weight: 600;
  text-decoration: none;
}
.rg-watch__btn:hover { background: var(--paper-sunk); border-color: var(--champagne-400); }
.rg-watch__btn svg { color: #c00; flex: none; }

